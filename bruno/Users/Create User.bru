meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Nuevo Usuario",
    "email": "nuevo@example.com",
    "password": "password1234",
    "role": "user"
  }
}

docs {
  Solo administradores: ejecuta antes "Login Admin". El registro público es Auth/Register.
  Contraseña: 12-72 caracteres.
  Con AUTH_MODE=full y correo activo, la cuenta recibe el enlace de verificación por email.
}
