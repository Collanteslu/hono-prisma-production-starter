# Configuración del Servidor
PORT=3011
NODE_ENV=development

# Secretos JWT (OBLIGATORIOS, sin valor por defecto: la app no arranca si están vacíos)
# Genera dos valores distintos con:  openssl rand -base64 48
# En producción: mínimo 32 caracteres y JWT_SECRET distinto de JWT_REFRESH_SECRET.
# Nunca reutilices los secretos de desarrollo en producción.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Base de Datos (SQLite Local por defecto)
DATABASE_URL=file:./dev.db

# Configuración Opcional para Turso LibSQL (Cloud / Edge)
# Si se definen, la API se conecta automáticamente a Turso en lugar del archivo SQLite local.
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu-turso-auth-token

# Proxy inverso (Cloudflare, Coolify, Traefik, Nginx)
# Habilitar solo cuando la API esté detrás de un reverse proxy de confianza para rate limiting real por IP
TRUST_PROXY=false

# Bootstrap del Administrador Inicial en Producción (Opcional)
# Si la base de datos está vacía en NODE_ENV=production, creará este usuario admin (contraseña de 8 a 72 caracteres)
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=cambia-esta-contraseña-12345

# Orígenes permitidos por CORS separados por comas (por defecto "*")
# CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com

# Documentación /docs y /openapi.json (por defecto activa salvo en producción)
# ENABLE_DOCS=false

# Rate limiting por IP (peticiones por ventana): login y refresh por minuto, registro por hora
# LOGIN_RATE_LIMIT_MAX=10
# REFRESH_RATE_LIMIT_MAX=30
# REGISTER_RATE_LIMIT_MAX=5

# Segundos en los que reutilizar un refresh token recién rotado se trata como refresh concurrente
# (fuera de esa ventana se considera robo del token y se revoca la sesión)
# REFRESH_REUSE_GRACE_SECONDS=10

# Nivel de log de Pino (trace, debug, info, warn, error, fatal, silent)
# LOG_LEVEL=info
